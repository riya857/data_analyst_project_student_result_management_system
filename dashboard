    # ======================================================
    # ANALOG CLOCK
    # ======================================================

    def update_clock(self):

        self.clock_canvas.delete("all")

        cx = 120
        cy = 115
        radius = 90

        # Outer circle
        self.clock_canvas.create_oval(
            cx - radius,
            cy - radius,
            cx + radius,
            cy + radius,
            outline="#173b4a",
            width=5
        )

        # Inner circle
        self.clock_canvas.create_oval(
            cx - 80,
            cy - 80,
            cx + 80,
            cy + 80,
            outline="#102d3a",
            width=2
        )

        # Tick marks
        for i in range(60):

            angle = math.radians(
                i * 6 - 90
            )

            x1 = cx + 82 * math.cos(angle)
            y1 = cy + 82 * math.sin(angle)

            x2 = cx + 88 * math.cos(angle)
            y2 = cy + 88 * math.sin(angle)

            self.clock_canvas.create_line(
                x1,
                y1,
                x2,
                y2,
                fill="#66808b",
                width=2
            )

        # Numbers
        for number in range(1, 13):

            angle = math.radians(
                number * 30 - 90
            )

            x = cx + 68 * math.cos(angle)
            y = cy + 68 * math.sin(angle)

            self.clock_canvas.create_text(
                x,
                y,
                text=str(number),
                font=("times new roman", 12, "bold"),
                fill="white"
            )

        # Current time
        hour = int(strftime("%H"))
        minute = int(strftime("%M"))
        second = int(strftime("%S"))

        # Hour hand
        hour_angle = math.radians(
            ((hour % 12) * 30)
            + (minute * 0.5)
            - 90
        )

        hx = cx + 45 * math.cos(hour_angle)
        hy = cy + 45 * math.sin(hour_angle)

        self.clock_canvas.create_line(
            cx,
            cy,
            hx,
            hy,
            fill="#ff3055",
            width=5
        )

        # Minute hand
        minute_angle = math.radians(
            minute * 6 - 90
        )

        mx = cx + 62 * math.cos(minute_angle)
        my = cy + 62 * math.sin(minute_angle)

        self.clock_canvas.create_line(
            cx,
            cy,
            mx,
            my,
            fill="white",
            width=3
        )

        # Second hand
        second_angle = math.radians(
            second * 6 - 90
        )

        sx = cx + 70 * math.cos(second_angle)
        sy = cy + 70 * math.sin(second_angle)

        self.clock_canvas.create_line(
            cx,
            cy,
            sx,
            sy,
            fill="#00ffff",
            width=2
        )

        # Center
        self.clock_canvas.create_oval(
            cx - 5,
            cy - 5,
            cx + 5,
            cy + 5,
            fill="#00ffff",
            outline="#00ffff"
        )

        # Digital time
        self.clock_canvas.create_text(
            cx,
            210,
            text=strftime("%I:%M:%S %p"),
            font=("goudy old style", 14, "bold"),
            fill="#00ffff"
        )

        self.root.after(
            1000,
            self.update_clock
        )


